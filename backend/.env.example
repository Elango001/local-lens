# LocalLens Environment Configuration
# Copy this file to .env and customize with your PostgreSQL credentials:
# cp .env.example .env

# PostgreSQL Database Connection String
# Syntax: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/locallens

# JWT Authentication Secret Key
SECRET_KEY=locallens-super-secret-jwt-key-2026-development
